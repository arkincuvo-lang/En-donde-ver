{
  "id": "tmdb-catalog-mx",
  "name": "TMDB Catálogo y Disponibilidad",
  "version": "1.0.0",
  "apiVersion": 1,
  "entry": "plugin.js",
  "description": "Busca películas y series en TMDB, muestra disponibilidad en streaming (México y otros países) y abre en app oficial.",
  "hosts": [
    "api.themoviedb.org",
    "image.tmdb.org"
  ],
  "capabilities": [
    "search",
    "resolve",
  ],
  "settings": [
    {
      "key": "tmdb_api_key",
      "label": "API Key de TMDB",
      "type": "text",
      "default": "9d185627a7959b27ea6c2b6acfe308a1",
      "hint": "Ingresa tu clave de TMDB"
    }
  ]
}
